# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Google Maps Platform API Key (Client SDK)
VITE_GOOGLE_MAPS_API_KEY=

# Server-Side Document Encryption & Payment Receipt Signing (32+ byte hex/string; ephemeral fallback in dev if unset)
DOCUMENT_ENCRYPTION_KEY=
PAYMENT_SIGNING_SECRET=

# Ethiopian Payment Providers (Chapa, Telebirr, CBE Birr)
CHAPA_SECRET_KEY=
CHAPA_WEBHOOK_SECRET=
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_MERCHANT_CODE=
CBE_BIRR_API_KEY=
CBE_BIRR_MERCHANT_ID=

# Email OTP & Notification Delivery (SMTP / Nodemailer)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Ethiopian SMS OTP Gateway (e.g., AfroMessage / Ethio Telecom SMS API)
ETHIO_SMS_GATEWAY_URL=
ETHIO_SMS_API_KEY=
ETHIO_SMS_SENDER_ID=
