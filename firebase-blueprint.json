          "type": "string",
          "enum": ["active", "expiring_soon", "expired", "payment_pending", "payment_failed", "cancelled", "suspended"]
        },
        "subscriptionExpiresAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "name", "ownerPharmacistName", "licenseNumber", "region", "city", "phone", "verificationStatus", "createdAt", "updatedAt"]
    },
    "VerificationDoc": {
      "title": "VerificationDoc",
      "description": "Private pharmacy license verification document metadata.",
      "type": "object",
      "properties": {
        "pharmacyId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
