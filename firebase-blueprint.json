{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Operational user profile for customers, pharmacy staff, and administrators.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["customer", "pharmacy", "support", "moderator", "admin", "super_admin"] },
        "city": { "type": "string", "maxLength": 100 },
        "language": { "type": "string", "enum": ["en", "am", "om", "ti", "so"] },
        "photoUrl": { "type": "string", "maxLength": 500 },
        "notificationSoundEnabled": { "type": "boolean" },
        "accessibilityHighContrast": { "type": "boolean" },
        "subscriptionStatus": {
          "type": "string",
          "enum": ["active", "expiring_soon", "expired", "payment_pending", "payment_failed", "cancelled", "suspended", "free_tier"]
        },
        "subscriptionExpiresAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "language", "subscriptionStatus", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII record for a user containing email, phone, and verification state.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "maxLength": 200 },
        "phone": { "type": "string", "maxLength": 32 },
        "phoneVerified": { "type": "boolean" },
        "emailVerified": { "type": "boolean" },
        "mfaEnabled": { "type": "boolean" },
        "consentGivenAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "phoneVerified", "emailVerified", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Authorized administrator role mapping.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "role": { "type": "string", "enum": ["super_admin", "admin", "moderator", "support"] },
