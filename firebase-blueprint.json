        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "genericName", "activeIngredient", "dosageForm", "category", "prescriptionClass", "verifiedSource", "createdAt", "updatedAt"]
    },
    "PharmacyInventory": {
      "title": "PharmacyInventory",
